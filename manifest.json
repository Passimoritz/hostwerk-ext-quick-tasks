{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "quick-tasks",
  "color": "#a855f7",
  "category": "developer",
  "name": {
    "de": "Schnell-Aufgaben",
    "en": "Quick tasks"
  },
  "description": {
    "de": "Deine Aufgaben als große Knöpfe – ein Klick startet ein Backup, einen Bericht oder ein Skript (Hostwerk fragt vorher). Lieblinge anheften, auch als Kachel.",
    "en": "Your tasks as big buttons – one click runs a backup, a report or a script (Hostwerk asks first). Pin favourites, also as a tile."
  },
  "permissions": [
    "read:tasks",
    "run:tasks",
    "storage",
    "native"
  ],
  "backend": "server/index.js",
  "page": {
    "title": {
      "de": "Schnell-Aufgaben",
      "en": "Quick tasks"
    },
    "icon": "zap",
    "file": "page/index.html",
    "description": {
      "de": "Deine Aufgaben als große Knöpfe – ein Klick startet ein Backup, einen Bericht oder ein Skript (Hostwerk fragt vorher). Lieblinge anheften, auch als Kachel.",
      "en": "Your tasks as big buttons – one click runs a backup, a report or a script (Hostwerk asks first). Pin favourites, also as a tile."
    },
    "nav": false
  },
  "widget": {
    "title": {
      "de": "Schnell starten",
      "en": "Quick start"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "version": "1.5.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-quick-tasks",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "hostwerk": ">=3.0.0",
  "contributes": {
    "actions": [
      {
        "id": "run",
        "title": {
          "de": "Aufgabe starten …",
          "en": "Run a task …"
        },
        "icon": "zap",
        "on": [
          "palette"
        ]
      }
    ],
    "new": [
      {
        "id": "run",
        "title": {
          "de": "Aufgabe starten",
          "en": "Run a task"
        },
        "description": {
          "de": "Eine deiner Aufgaben per Suche starten",
          "en": "Find one of your tasks and run it"
        },
        "icon": "zap"
      }
    ],
    "shortcuts": [
      {
        "id": "run",
        "title": {
          "de": "Aufgabe starten …",
          "en": "Run a task …"
        },
        "keys": "ctrl+alt+q",
        "action": "run"
      }
    ],
    "tabs": [
      {
        "id": "quick",
        "title": {
          "de": "Schnellaufgaben",
          "en": "Quick tasks"
        },
        "icon": "zap",
        "on": "area:tasks",
        "file": "page/index.html"
      }
    ]
  },
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  },
  "sdkVersion": "3.2"
}
